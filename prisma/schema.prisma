generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Core Models
model User {
  // Stores the Supabase Auth user UUID from auth.users.
  id            String    @id
  email         String    @unique
  name          String
  firstName     String?
  lastName      String?
  phone         String?
  idType        String?
  idNumber      String?
  role          String    @default("CLIENT")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings  Booking[]
  tickets   Ticket[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([role, createdAt])
}

model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  address   String
  city      String
  mapUrl    String?
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  slots Slot[]

  @@index([slug])
}

model Slot {
  id           String   @id @default(cuid())
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id])
  name         String
  type         String
  capacity     Int      @default(1)
  pricePerUnit Float
  currency     String   @default("INR")
  unit         String   @default("HOUR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@index([campusId, type, isActive])
}

model Booking {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId     String
  slot       Slot      @relation(fields: [slotId], references: [id])
  status     String    @default("PENDING")
  startTime  DateTime
  endTime    DateTime
  totalPrice Float
  seats      Int       @default(1)
  seatIds    String[]
  notes      String?   @db.Text
  adminNotes String?   @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tickets Ticket[]

  @@index([userId, status, startTime])
  @@index([slotId, startTime, endTime])
  @@index([status, createdAt])
  @@index([slotId, status, startTime])
}

model Ticket {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  code       String   @unique
  qrData     String   @db.Text
  status     String   @default("VALID")
  validFrom  DateTime
  validUntil DateTime

  // New fields for multi-seat meeting-room tickets
  attendeeIndex  Int? // 1..N (e.g. seat/attendee number)
  recipientName  String?
  recipientEmail String?
  sentAt         DateTime?

  usedAt    DateTime?
  scannedBy String?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([bookingId])
  @@index([userId, status])
  @@index([userId, status, validUntil])
  @@index([recipientEmail])
  @@index([validFrom, validUntil, status])
}

// Audit Log for compliance & tracking admin actions
model AuditLog {
  id         String   @id @default(cuid())
  action     String // 'BOOKING_APPROVED', 'BOOKING_REJECTED', 'TICKET_VERIFIED', etc.
  userId     String? // Admin who performed the action
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetId   String // Booking ID, Ticket ID, or User ID
  targetType String // 'BOOKING', 'TICKET', 'USER'
  changes    Json? // What changed (status, ticketsCount, etc.)
  ipAddress  String? // For security tracking
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}
