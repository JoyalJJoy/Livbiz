# ==========================================
# LivBizz Production Environment Variables
# ==========================================
# Copy this file to .env and fill in real values
# Generate secrets with: openssl rand -base64 32

# ---------- Database ----------
# PostgreSQL connection string (Supabase, Neon, Railway, or self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/livbizz?schema=public"

# ---------- NextAuth ----------
# REQUIRED: Generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# REQUIRED: Full production URL (e.g. https://livbizz.com)
NEXTAUTH_URL="http://localhost:3000"

# ---------- Site URL ----------
# Used for SEO meta tags, Open Graph, and email links
NEXT_PUBLIC_SITE_URL="https://livbizz.com"

# ---------- SMTP Email ----------
# For transactional emails (booking confirmations, password resets)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="LivBizz Booking <your-email@gmail.com>"

# ---------- Ticket Security ----------
# REQUIRED: Generate with `openssl rand -base64 32`
TICKET_SIGNING_SECRET=""
