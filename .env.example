# ==========================================
# LivBizz Production Environment Variables
# ==========================================
# Copy this file to .env and fill in real values
# Generate secrets with: openssl rand -base64 32

# ---------- Database ----------
# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"

# ---------- Supabase Auth ----------
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------- Site URL ----------
# Used for SEO meta tags, Open Graph, and email links
NEXT_PUBLIC_SITE_URL="https://livbizz.com"

# ---------- SMTP Email ----------
# For transactional emails (booking confirmations, password resets)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="LivBizz Booking <your-email@gmail.com>"

# ---------- Ticket Security ----------
# REQUIRED: Generate with `openssl rand -base64 32`
TICKET_SIGNING_SECRET=""
